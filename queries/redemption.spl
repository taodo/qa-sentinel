index="sweeps"
"Payload.ClientPayload.action" IN ("redemption_attempt", "redemption_response")

| spath path=Payload.ClientPayload.client_type output=client_type
| spath path=Payload.ClientPayload.type output=type
| spath path=Payload.ClientPayload.status output=status
| spath path=Payload.ClientPayload.support_code output=support_code
| spath path=Payload.ClientPayload.game_user_id output=game_user_id
| spath path=Payload.ClientPayload.email output=email
| spath path=Payload.PartnerPlayerId output=partner_player_id

| eval action='Payload.ClientPayload.action'
| eval client_type=coalesce(client_type, "unknown")
| eval type=coalesce(type, "unknown")
| eval status=coalesce(status, "unknown")
| eval user_key=coalesce(partner_player_id, support_code, game_user_id, email)

| stats
    count as total_events
    dc(user_key) as unique_users
by action client_type type status

| sort action client_type type -total_events